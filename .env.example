NODE_ENV=development
BACKEND_PORT=3001
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://app_user:replace-me@localhost:5432/sentiment_analyzer
JWT_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_PSEUDONYM_KEY=replace-with-at-least-32-random-characters
RAW_TEXT_ENCRYPTION_KEY=replace-with-exactly-64-hex-characters-000000000000000000000000
ENABLE_LEGACY_UNSCOPED_ROUTES=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
